# 注意：Vercel/serverless 下 DATABASE_URL 走 Supabase 6543 transaction pooler 时必须加
# ?pgbouncer=true&connection_limit=1（防 serverless 连接风暴与 prepared statement 报错）；
# DIRECT_URL（5432 直连）仅用于 prisma migrate。
DATABASE_URL="postgresql://user:pass@host:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:pass@host:5432/postgres"
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
CRON_SECRET="change-me"

# 图纸上传与定时备份所需（Supabase Storage）
# 1. Supabase Dashboard → Storage → 创建 private bucket 名为 "drawings"（代码会自动确保私有）
# 2. 定时备份会自动创建 private bucket "backups"
# 3. Project Settings → API → 复制 service_role 密钥填入下方
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="change-me"

# 飞书群机器人 Webhook（新单即时通知 + 每日交期提醒；留空则跳过）
FEISHU_WEBHOOK_URL=""
