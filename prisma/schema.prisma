generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  DEALER
  WORKSHOP
}

// W1/D3: 状态机收敛；P1: +CANCELLED（订单取消联动，不走 TRANSITIONS 正常流转）
// 流转：PENDING_START→PROCESSING→(OUTSOURCING↔)→[QC]→PACKING→READY_TO_SHIP→SHIPPED；任意未发运态→CANCELLED(专用端点)
enum WorkOrderStatus {
  PENDING_START
  PROCESSING
  OUTSOURCING
  QC
  PACKING
  READY_TO_SHIP
  SHIPPED
  CANCELLED
}

enum PriceLevel {
  A
  B
  C
  D
  E
}

enum PaymentMethod {
  PREPAID
  DEPOSIT
  CREDIT
}

enum DealerStatus {
  ACTIVE
  INACTIVE
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  CREDIT
}

enum ProductCategory {
  PROFILE
  HARDWARE
}

enum OrderLineType {
  PROFILE
  HARDWARE
  OUTSOURCED
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum StockMovementType {
  PO_RECEIPT
  WORK_ORDER_CONSUME
  STOCK_COUNT_ADJUST
  MANUAL_ADJUST
  TRANSFER_OUT
  TRANSFER_IN
  PRODUCTION_RETURN
}

enum StockCountStatus {
  DRAFT
  SUBMITTED
  APPROVED
  CANCELLED
}

enum OrderStatus {
  DRAFT
  PENDING
  MODIFYING
  CONFIRMED
  PARTIALLY_PAID
  PRODUCING
  READY
  PARTIALLY_SHIPPED
  SHIPPED
  COMPLETED
  CANCELLED
  REJECTED
}

// W1: 订单来源（经销商门户自助 / 内部代下单）
enum OrderVia {
  PORTAL
  INTERNAL
}

// W1: 客户类型（经销商 / 直发散客）——注意与 CRM 的 CustomerType(COMPANY/INDIVIDUAL) 区分
enum DealerCustomerType {
  DEALER
  WALK_IN
}

// W1: 发货运费口径
enum FreightPayType {
  PREPAID
  COD
  MONTHLY
}

// W1: 发货地（车间 或 外协厂直发）
enum ShipmentFromType {
  FACTORY
  OUTSOURCER
}

enum SupplierCategory {
  RAW_MATERIAL
  HARDWARE
  OUTSOURCED
  LOGISTICS
  SERVICE
  OTHER
}

// 账号生命周期：停用后无法登录（保留历史与审计）；无业务记录的账号可硬删
enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id                       String     @id @default(cuid())
  email                    String     @unique
  name                     String
  password                 String
  role                     UserRole   @default(DEALER)
  status                   UserStatus @default(ACTIVE)
  dealerId                 String?
  workshopId               String?
  mustChangePassword       Boolean   @default(false)
  passwordChangedAt        DateTime?
  activationTokenHash      String?
  activationTokenExpiresAt DateTime?
  activationTokenCreatedAt DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  dealer   Dealer?   @relation(fields: [dealerId], references: [id])
  workshop Workshop? @relation(fields: [workshopId], references: [id])

  @@index([activationTokenHash])
}

model Workshop {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  contactName  String?
  contactPhone String?
  address      String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users          User[]
  workOrders     WorkOrder[]
  purchaseOrders PurchaseOrder[]
  inventory      WorkshopInventory[]
  movements      StockMovement[]
  stockCounts    StockCount[]
  transferOuts   TransferOrder[] @relation("TransferFrom")
  transferIns    TransferOrder[] @relation("TransferTo")
}

model WorkOrder {
  id                    String          @id @default(cuid())
  workOrderNo           String          @unique
  orderNo               String          @unique
  workshopId            String
  status                WorkOrderStatus @default(PENDING_START)
  committedDeliveryDate DateTime?
  actualShippedAt       DateTime?
  carrier               String?
  trackingNo            String?
  currentNote           String?
  delayReason           String?
  // P1(A): 承诺交期早于系统建议值时的强行提前原因（与 delayReason 语义分开）
  committedOverrideReason String?
  qcRequired            Boolean         @default(true)
  printedAt             DateTime?
  assignedBy            String?
  assignedAt            DateTime        @default(now())
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  order    SalesOrder       @relation(fields: [orderNo], references: [orderNo], onDelete: Cascade)
  workshop Workshop         @relation(fields: [workshopId], references: [id])
  events   WorkOrderEvent[]
}

model WorkOrderEvent {
  id             String           @id @default(cuid())
  workOrderId    String
  fromStatus     WorkOrderStatus?
  toStatus       WorkOrderStatus
  note           String?
  operatorUserId String?
  operatorName   String?
  createdAt      DateTime         @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
}

model Dealer {
  id              String        @id @default(cuid())
  dealerNo        String        @unique
  companyName     String
  contactName     String
  contactPhone    String
  // W1: 客户类型与散客字段（D1 决策：散客复用 Dealer，不参与信用/等级）
  customerType    DealerCustomerType @default(DEALER)
  nickname        String?
  internalOwnerUserId String?
  legalName       String?
  taxNo           String?
  invoiceTitle    String?
  invoiceType     String?
  bankName        String?
  bankAccount     String?
  region          String?
  industry        String?
  source          String?
  salesOwner      String?
  creditDays      Int           @default(0)
  allowOverCredit Boolean       @default(false)
  remark          String?
  priceLevel      PriceLevel    @default(C)
  stampUrl        String?
  creditLimit     Decimal       @default(0) @db.Decimal(12, 2)
  creditBalance   Decimal       @default(0) @db.Decimal(12, 2)
  usedCredit      Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod   PaymentMethod @default(PREPAID)
  // P1(D): 先款后产开关——开启后非内部单需收清才能派单/发货（D2：内部单始终不拦）
  enforcePrepay   Boolean     @default(false)
  status          DealerStatus  @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  users        User[]
  addresses    DealerAddress[]
  contacts     DealerContact[]
  salesOrders  SalesOrder[]
  payments     DealerPayment[]
  crmCustomers CrmCustomer[]
}

model DealerContact {
  id        String   @id @default(cuid())
  dealerId  String
  role      String   @default("业务联系人")
  name      String
  phone     String?
  email     String?
  wechat    String?
  isPrimary Boolean  @default(false)
  remark    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dealer Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([dealerId])
}

model DealerAddress {
  id            String   @id @default(cuid())
  dealerId      String
  // warehouse = 客户自用收货地址；dropship = 代发地址（客户下单、直发他的终端客户）
  addressType   String   @default("warehouse")
  // 地址标签（代发场景 = 终端客户名/门店名，如"代发·杭州万象城店"）
  label         String?
  receiverName  String
  receiverPhone String
  province      String
  city          String
  district      String
  detailAddress String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())

  dealer Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)
}

model Product {
  id              String          @id @default(cuid())
  sku             String          @unique
  productName     String
  series          String
  category        ProductCategory @default(PROFILE)
  lengthInch      Decimal?        @db.Decimal(6, 2)
  lengthMm        Decimal?        @db.Decimal(8, 2)
  isCustom        Boolean         @default(false)
  retailPrice     Decimal         @db.Decimal(10, 2)
  purchasePrice   Decimal?        @db.Decimal(10, 2)
  unit            String          @default("根")
  drawingRequired Boolean         @default(false)
  spec            String?
  // 型材默认表面处理/颜色（可空=未指定）；代下选用到该原料时预填到订单行
  surfaceProcessCode String?
  surfaceColorCode   String?
  // 原料阶段：RAW=定尺长管（挤压+表面处理完成）、SEMI=半成品段（已截断待铣孔/预埋，总部仓备货）；null=普通成品/五金
  materialStage      String?
  // 截面米重 kg/m（物理常数，同截面各表面变体共享；成本=每米价×切长÷良率 的换算基数）
  weightPerMeter     Decimal? @db.Decimal(7, 4)
  isRawMaterial   Boolean         @default(false)
  yieldRate       Decimal         @default(0.95) @db.Decimal(5, 4)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model SalesOrder {
  id                    String        @id @default(cuid())
  orderNo               String        @unique
  dealerId              String
  orderDate             DateTime      @default(now())
  targetDeliveryDate    DateTime
  suggestedDeliveryDate DateTime?
  actualDeliveryDate    DateTime?
  dealerAccount         String
  reviewer              String?
  reviewTime            DateTime?
  reviewRemark          String?
  paymentStatus         PaymentStatus @default(UNPAID)
  orderStatus           OrderStatus   @default(DRAFT)
  totalAmount           Decimal       @db.Decimal(12, 2)
  confirmedAmount       Decimal?      @db.Decimal(12, 2)
  paidAmount            Decimal       @default(0) @db.Decimal(12, 2)
  discountRate          Decimal?      @db.Decimal(5, 2)
  logisticsNo           String?
  receiverName          String
  receiverPhone         String
  receiverAddress       String
  remark                String?
  internalRemark        String?
  crmCustomerId         String?
  crmOpportunityId      String?
  // W1: 内部代下单与 Base 迁移字段（D2/D4/D5 决策）
  createdVia            OrderVia @default(PORTAL)
  createdByUserId       String?
  priceNote             String?
  legacyBaseNo          String?  @unique
  displayOrderNo        String?  @unique
  needsReview           Boolean  @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  dealer             Dealer                    @relation(fields: [dealerId], references: [id])
  lines              SalesOrderLine[]
  workOrder          WorkOrder?
  shipments          ShipmentLine[]
  paymentAllocations DealerPaymentAllocation[]
  crmCustomer        CrmCustomer?              @relation(fields: [crmCustomerId], references: [id], onDelete: SetNull)
  crmOpportunity     CrmOpportunity?           @relation(fields: [crmOpportunityId], references: [id], onDelete: SetNull)

  // P0(A5): 列表按客户/状态筛选与详情 join 的关键索引
  @@index([dealerId, createdAt])
  @@index([orderStatus])
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model AuditLog {
  id               String    @id @default(cuid())
  action           String
  entityType       String
  entityId         String?
  summary          String
  detail           Json?
  actorUserId      String?
  actorName        String?
  actorEmail       String?
  actorRole        UserRole?
  targetUserId     String?
  targetDealerId   String?
  targetWorkshopId String?
  createdAt        DateTime  @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
}

model SalesOrderLine {
  id               String        @id @default(cuid())
  orderNo          String
  lineNo           Int
  lineType         OrderLineType @default(PROFILE)
  sku              String
  productName      String
  productId        String?
  rawProductId     String?
  cutLengthMm      Int?
  lengthMm         Decimal?      @db.Decimal(8, 2)
  surfaceTreatment String?
  preprocessing    String?
  // W1: 新口径字段（旧列过渡期保留）：工序多选存码；表面处理拆工艺码+颜色码；Base 原始尺寸文本
  processCodes     String[]
  surfaceProcessCode String?
  surfaceColorCode String?
  legacyRawSize    String?
  spec             String?
  quantity         Int
  unitPrice        Decimal       @db.Decimal(10, 2)
  targetPrice      Decimal?      @db.Decimal(10, 2)
  confirmedPrice   Decimal?      @db.Decimal(10, 2)
  lineAmount       Decimal       @db.Decimal(12, 2)
  // 下单时冻结的成本构成 JSON（{perMeter, meterWeight, yieldRate, unitCost, source}）；null=未快照，利润页回退实时重算
  costSnapshot     String?
  includedInProfit Boolean       @default(true)
  workOrderNo      String?
  isCustom         Boolean       @default(false)
  imageUrl         String?
  drawingUrl       String?
  drawingFileName  String?
  createdAt        DateTime      @default(now())

  order         SalesOrder     @relation(fields: [orderNo], references: [orderNo], onDelete: Cascade)
  shipmentLines ShipmentLine[]

  @@index([orderNo])
}

// W2: 收藏常用组合（下单快捷插入；候选可由历史 69% 重复组合自动归集）
model OrderCombo {
  id            String    @id @default(cuid())
  name          String
  lines         Json      // [{lineType, rawProductId?, productId?, sku, productName, cutLengthMm?, processCodes[], surfaceProcessCode?, surfaceColorCode?, quantity}]
  signature     String    @unique
  source        String    @default("manual") // manual | auto-history
  usageCount    Int       @default(0)
  lastUsedAt    DateTime?
  createdByUserId String?
  createdAt     DateTime  @default(now())

  @@index([source, usageCount])
}

// W1: Shipment 发货事件流（一单多张=补发/部分发；多单合发；到付；外协厂直发）
model Shipment {
  id              String           @id @default(cuid())
  shipmentNo      String           @unique
  carrier         String
  trackingNo      String?
  shippedAt       DateTime         @default(now())
  freightPayType  FreightPayType   @default(PREPAID)
  fromType        ShipmentFromType @default(FACTORY)
  fromNote        String?
  note            String?
  createdByUserId String?
  createdByName   String?
  createdAt       DateTime         @default(now())

  lines ShipmentLine[]

  @@index([shippedAt])
  @@index([carrier, trackingNo])
}

model ShipmentLine {
  id         String     @id @default(cuid())
  shipmentId String
  orderNo    String
  lineId     String
  quantity   Int
  createdAt  DateTime   @default(now())

  shipment Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  order    SalesOrder    @relation(fields: [orderNo], references: [orderNo], onDelete: Cascade)
  line     SalesOrderLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([orderNo])
}

model Supplier {
  id                  String           @id @default(cuid())
  supplierNo          String           @unique
  name                String
  category            SupplierCategory @default(OTHER)
  contactName         String?
  contactPhone        String?
  address             String?
  taxNo               String?
  invoiceType         String?
  bankName            String?
  bankAccount         String?
  paymentTerms        String?
  paymentDays         Int              @default(0)
  defaultLeadTimeDays Int              @default(0)
  serviceScope        String?
  remark              String?
  isActive            Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  purchaseOrders PurchaseOrder[]
  payments       SupplierPayment[]
  contacts       SupplierContact[]
}

model SupplierContact {
  id         String   @id @default(cuid())
  supplierId String
  role       String   @default("业务联系人")
  name       String
  phone      String?
  email      String?
  wechat     String?
  isPrimary  Boolean  @default(false)
  remark     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

model PurchaseOrder {
  id              String              @id @default(cuid())
  poNo            String              @unique
  supplierId      String
  workshopId      String
  status          PurchaseOrderStatus @default(DRAFT)
  orderDate       DateTime            @default(now())
  expectedDate    DateTime?
  totalAmount     Decimal             @db.Decimal(12, 2)
  paidAmount      Decimal             @default(0) @db.Decimal(12, 2)
  receiverName    String?
  receiverPhone   String?
  receiverAddress String?
  remark          String?
  createdBy       String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  supplier           Supplier                    @relation(fields: [supplierId], references: [id])
  workshop           Workshop                    @relation(fields: [workshopId], references: [id])
  lines              PurchaseOrderLine[]
  paymentAllocations SupplierPaymentAllocation[]
}

model PurchaseOrderLine {
  id          String  @id @default(cuid())
  poNo        String
  lineNo      Int
  sku         String
  productName String
  spec        String?
  quantity    Int
  receivedQty Int     @default(0)
  unitPrice   Decimal @db.Decimal(10, 2)
  lineAmount  Decimal @db.Decimal(12, 2)
  // 批次计价第 2 步：铝型材按重量批次结算（BAR=按根 元/根；KG=按重量 元/kg）
  pricingUnit       String?          // 'BAR' | 'KG'；存量与缺省 = BAR
  totalWeightKg     Decimal? @db.Decimal(10, 2) // KG 行：下单约重（预估金额基数）
  receivedWeightKg  Decimal? @db.Decimal(10, 2) // KG 行：累计实收磅重（应付=结算单价×此值）
  settleUnitPrice   Decimal? @db.Decimal(10, 4) // KG 行：结算单价 元/kg

  po PurchaseOrder @relation(fields: [poNo], references: [poNo], onDelete: Cascade)

  @@index([poNo])
}

// 库位间调拨：总部仓 ↔ 车间仓移库，两条流水（出/入），数量移动、每米成本随行
model TransferOrder {
  id             String   @id @default(cuid())
  transferNo     String   @unique
  fromWorkshopId String
  toWorkshopId   String
  note           String?
  operatorName   String?
  createdAt      DateTime @default(now())

  fromWorkshop Workshop       @relation("TransferFrom", fields: [fromWorkshopId], references: [id])
  toWorkshop   Workshop       @relation("TransferTo", fields: [toWorkshopId], references: [id])
  lines        TransferLine[]

  @@index([fromWorkshopId])
  @@index([toWorkshopId])
}

model TransferLine {
  id          String @id @default(cuid())
  transferId  String
  sku         String
  productName String
  quantity    Int

  transfer TransferOrder @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
}

model WorkshopInventory {
  id                String   @id @default(cuid())
  workshopId        String
  sku               String
  productName       String
  quantity          Int      @default(0)
  lowStockThreshold Int      @default(0)
  // 移动加权平均每米成本（元/米，分车间滚动）；仅采购收货时重算，扣料/盘点只动数量
  avgCostPerMeter   Decimal? @db.Decimal(10, 4)
  updatedAt         DateTime @updatedAt

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@unique([workshopId, sku])
  @@index([workshopId])
}

model StockMovement {
  id           String            @id @default(cuid())
  workshopId   String
  sku          String
  productName  String
  type         StockMovementType
  quantity     Int
  balanceAfter Int
  // 出入库时点的每米成本快照（元/米）：收货写批次价、扣料写当时车间均价，供成本追溯与加权回放
  unitCost     Decimal? @db.Decimal(12, 4)
  refType      String?
  refNo        String?
  // 炉批号：收货录入，同色不同批有色差风险，供追溯与同单同批核对
  batchNo      String?
  // 余段回库的来源整棒原料 SKU（PRODUCTION_RETURN 专用，结构化反查替代 note 解析）
  sourceSku    String?
  note         String?
  operatorName String?
  createdAt    DateTime          @default(now())

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@index([workshopId, sku, createdAt])
  @@index([type, createdAt])
  @@index([refType, refNo])
}

model StockCount {
  id          String           @id @default(cuid())
  countNo     String           @unique
  workshopId  String
  status      StockCountStatus @default(DRAFT)
  remark      String?
  submittedBy String?
  submittedAt DateTime?
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workshop Workshop         @relation(fields: [workshopId], references: [id])
  lines    StockCountLine[]
}

model StockCountLine {
  id          String @id @default(cuid())
  countNo     String
  sku         String
  productName String
  systemQty   Int
  actualQty   Int
  diff        Int

  count StockCount @relation(fields: [countNo], references: [countNo], onDelete: Cascade)
}

model DealerPayment {
  id             String   @id @default(cuid())
  dealerId       String
  amount         Decimal  @db.Decimal(12, 2)
  creditReleased Decimal  @default(0) @db.Decimal(12, 2)
  paidAt         DateTime
  method         String?
  refNo          String?
  note           String?
  recordedBy     String?
  createdAt      DateTime @default(now())

  dealer      Dealer                    @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  allocations DealerPaymentAllocation[]

  @@index([dealerId, paidAt])
}

model DealerPaymentAllocation {
  id        String   @id @default(cuid())
  paymentId String
  orderNo   String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  payment DealerPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  order   SalesOrder    @relation(fields: [orderNo], references: [orderNo], onDelete: Cascade)

  @@index([paymentId])
  @@index([orderNo])
}

model SupplierPayment {
  id         String   @id @default(cuid())
  supplierId String
  amount     Decimal  @db.Decimal(12, 2)
  paidAt     DateTime
  method     String?
  refNo      String?
  note       String?
  recordedBy String?
  createdAt  DateTime @default(now())

  supplier    Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  allocations SupplierPaymentAllocation[]

  @@index([supplierId, paidAt])
}

model SupplierPaymentAllocation {
  id        String   @id @default(cuid())
  paymentId String
  poNo      String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  payment SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  po      PurchaseOrder   @relation(fields: [poNo], references: [poNo], onDelete: Cascade)

  @@index([paymentId])
  @@index([poNo])
}

// =======================================================================
// CRM (Phase 1)
// =======================================================================

enum CustomerStage {
  LEAD
  POTENTIAL
  QUOTED
  DEAL
  LOST
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
  DESIGNER
  CONTRACTOR
}

enum IntentLevel {
  HIGH
  MEDIUM
  LOW
}

enum ContactMethod {
  PHONE
  WECHAT
  VISIT
  ONSITE
  MEETING
  OTHER
}

enum OpportunityStage {
  DISCOVERY
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum CrmTaskStatus {
  PENDING
  DONE
  CANCELLED
}

model CrmCustomer {
  id            String        @id @default(cuid())
  dealerId      String
  customerType  CustomerType  @default(INDIVIDUAL)
  name          String
  phone         String
  email         String?
  wechat        String?
  address       String?
  region        String?
  source        String?
  tags          String[]      @default([])
  stage         CustomerStage @default(LEAD)
  intentLevel   IntentLevel?
  budget        Decimal?      @db.Decimal(12, 2)
  demand        String?
  nextFollowAt  DateTime?
  lastContactAt DateTime?
  remark        String?
  ownerUserId   String?
  createdBy     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  dealer        Dealer           @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  contactLogs   CrmContactLog[]
  opportunities CrmOpportunity[]
  tasks         CrmTask[]
  salesOrders   SalesOrder[]

  @@index([dealerId, stage])
  @@index([dealerId, nextFollowAt])
  @@index([dealerId, phone])
}

model CrmContactLog {
  id            String        @id @default(cuid())
  dealerId      String
  customerId    String
  opportunityId String?
  method        ContactMethod @default(PHONE)
  content       String
  outcome       String?
  nextAction    String?
  attachmentUrl String?
  createdBy     String?
  createdAt     DateTime      @default(now())

  customer    CrmCustomer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunity CrmOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([dealerId, createdAt])
  @@index([customerId, createdAt])
}

model CrmOpportunity {
  id                String           @id @default(cuid())
  dealerId          String
  customerId        String
  title             String
  stage             OpportunityStage @default(DISCOVERY)
  estimatedBudget   Decimal?         @db.Decimal(12, 2)
  expectedCloseDate DateTime?
  actualAmount      Decimal          @default(0) @db.Decimal(12, 2)
  wonAt             DateTime?
  lostReason        String?
  remark            String?
  createdBy         String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  customer    CrmCustomer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contactLogs CrmContactLog[]
  tasks       CrmTask[]
  salesOrders SalesOrder[]

  @@index([dealerId, stage])
  @@index([customerId])
}

model CrmTask {
  id              String        @id @default(cuid())
  dealerId        String
  customerId      String?
  opportunityId   String?
  title           String
  dueAt           DateTime
  reminderContent String?
  status          CrmTaskStatus @default(PENDING)
  completedAt     DateTime?
  assigneeUserId  String?
  createdBy       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer    CrmCustomer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunity CrmOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([dealerId, status, dueAt])
}
